# Copy to .env and fill in. Never commit .env.
# Only the key for config.toml's `provider` is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Slack app -> Incoming Webhooks -> Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
# Optional: bot token (chat:write) + channel ID, so qualifications go in a thread reply. See README.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Dedicated Gmail that job-alert emails are forwarded to (config.toml [companies] email).
# Needs 2-Step Verification on, then myaccount.google.com/apppasswords. Not the account password.
ALERT_EMAIL=
ALERT_EMAIL_APP_PASSWORD=
